#!/bin/bash

DISCORD_WEBHOOK="https://discord.com/api/webhooks/1522976376246763673/4OiFCAvV0Z7Bd22nIV6ZYFWXIrsxwtufoZUCpIH5J_dOuMHztuIWbcJSDqgT9Q2dDgnq"
IMAGE_URL="https://i.pinimg.com/736x/14/cd/b8/14cdb8ffeb8017a8a431f12f6c65f2a0.jpg"
ROOT_DIR="/sdcard/Download"

export PREFIX="/data/data/com.termux/files/usr"
export PATH="$PREFIX/bin:$PATH"

termux-wake-lock 2>/dev/null
START_TIME=$(date +%s)

cleanup() {
    echo -e "\n\033[0;31m[!] Đang tắt Web Panel & Tunnel...\033[0m"
    pkill -f "code-server" 2>/dev/null
    pm2 delete tunnel 2>/dev/null
    termux-wake-unlock 2>/dev/null
    exit 0
}
trap cleanup SIGINT SIGTERM SIGHUP EXIT

[ ! -d "$ROOT_DIR" ] && termux-setup-storage && sleep 3

if ! command -v code-server >/dev/null 2>&1 || ! command -v node >/dev/null 2>&1 || ! command -v cloudflared >/dev/null 2>&1; then
    echo "[*] Đang cài đặt môi trường Server Host..."
    pkg update -y
    pkg install tur-repo -y
    pkg update -y
    pkg install nodejs-lts python git cloudflared code-server -y
fi
command -v pm2 >/dev/null 2>&1 || npm install -g pm2 >/dev/null 2>&1

git config --global --add safe.directory '*' 2>/dev/null

# Dọn tiến trình cũ và chạy trực tiếp code-server qua nohup
pkill -f "code-server" 2>/dev/null
pm2 delete web-panel tunnel 2>/dev/null

CODE_LOG="$HOME/code-server.log"
rm -f "$CODE_LOG"
nohup code-server --bind-addr 127.0.0.1:8080 --auth none --disable-telemetry "$ROOT_DIR" > "$CODE_LOG" 2>&1 &

echo "Đang đợi Web Panel mở cổng 8080..."
WEB_READY=0
for i in {1..30}; do
    if curl -s -o /dev/null http://127.0.0.1:8080; then
        WEB_READY=1
        break
    fi
    sleep 1
done

if [ "$WEB_READY" -eq 0 ]; then
    echo -e "\033[0;31m[!] code-server không mở được cổng 8080. Chi tiết lỗi:\033[0m"
    cat "$CODE_LOG"
    exit 1
fi

CLOUDFLARE_LOG="$HOME/cloudflare.log"
rm -f "$CLOUDFLARE_LOG"
pm2 start cloudflared --name "tunnel" --output "$CLOUDFLARE_LOG" --error "$CLOUDFLARE_LOG" -- tunnel --url http://127.0.0.1:8080 >/dev/null 2>&1
pm2 save >/dev/null 2>&1

echo "Đang lấy link kết nối..."
TUNNEL_URL=""
for i in {1..30}; do
    sleep 1
    if [ -f "$CLOUDFLARE_LOG" ]; then
        TUNNEL_URL=$(grep -o 'https://[-a-zA-Z0-9@:%._\+~#=]*\.trycloudflare\.com' "$CLOUDFLARE_LOG" | tail -n 1)
        [ -n "$TUNNEL_URL" ] && break
    fi
done

if [ -n "$TUNNEL_URL" ]; then
    curl -H "Content-Type: application/json" \
         -X POST \
         -d "{
           \"embeds\": [{
             \"title\": \"🖥️ Termux Server Host đã Online!\",
             \"description\": \"📂 **Thư mục tổng:** \`/sdcard/Download\`\n🔗 **Web Panel:** $TUNNEL_URL\",
             \"color\": 16033721,
             \"image\": { \"url\": \"$IMAGE_URL\" }
           }]
         }" \
         "$DISCORD_WEBHOOK" > /dev/null 2>&1
fi

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

format_bytes() {
    local b=$1
    if [ "$b" -ge 1073741824 ]; then awk -v b="$b" 'BEGIN {printf "%.2f GB", b/1073741824}'
    elif [ "$b" -ge 1048576 ]; then awk -v b="$b" 'BEGIN {printf "%.2f MB", b/1048576}'
    elif [ "$b" -ge 1024 ]; then awk -v b="$b" 'BEGIN {printf "%.2f KB", b/1024}'
    else echo "${b} B"; fi
}

while true; do
    TUNNEL_STATUS=$(pm2 describe tunnel 2>/dev/null | grep -o "online" | head -n 1)
    [ "$TUNNEL_STATUS" != "online" ] && echo -e "\n${RED}[!] Cloudflare Tunnel đã ngắt kết nối.${NC}" && cleanup

    if curl -s -o /dev/null http://127.0.0.1:8080; then
        WEB_DISPLAY="${GREEN}ONLINE${NC}"
    else
        WEB_DISPLAY="${RED}OFFLINE (Đang khởi động lại...)${NC}"
        nohup code-server --bind-addr 127.0.0.1:8080 --auth none --disable-telemetry "$ROOT_DIR" > "$CODE_LOG" 2>&1 &
    fi

    ACTIVE_APPS=$(pm2 jlist 2>/dev/null | grep -o '"status":"online"' | wc -l)
    USER_APPS=$(( ACTIVE_APPS > 1 ? ACTIVE_APPS - 1 : 0 ))

    RAM_FREE=$(free -m | awk '/Mem:/ {print $7}')
    [ -z "$RAM_FREE" ] && RAM_FREE=$(free -m | awk '/Mem:/ {print $4}')
    DISK_FREE=$(df -h /data 2>/dev/null | awk 'NR==2 {print $4}')

    read -r TOTAL_RX TOTAL_TX <<< "$(awk 'NR>2 && $1 !~ /lo/ {rx+=$2; tx+=$10} END {print rx, tx}' /proc/net/dev 2>/dev/null)"
    RX_FMT=$(format_bytes "${TOTAL_RX:-0}")
    TX_FMT=$(format_bytes "${TOTAL_TX:-0}")

    CURRENT_TIME=$(date +%s)
    DIFF_SEC=$(( CURRENT_TIME - START_TIME ))
    UP_DAYS=$(( DIFF_SEC / 86400 ))
    UP_HOURS=$(( (DIFF_SEC % 86400) / 3600 ))
    UP_MINS=$(( (DIFF_SEC % 3600) / 60 ))
    UP_SECS=$(( DIFF_SEC % 60 ))

    SERVER_UPTIME=""
    [ $UP_DAYS -gt 0 ] && SERVER_UPTIME="${UP_DAYS}d "
    [ $UP_HOURS -gt 0 ] && SERVER_UPTIME="${SERVER_UPTIME}${UP_HOURS}h "
    SERVER_UPTIME="${SERVER_UPTIME}${UP_MINS}m ${UP_SECS}s"

    clear
    echo -e "${CYAN}"
    cat << "LOGO"
  _                  _     _     _       
 | |    _   _   ___ | |__ | | __(_) _ __  
 | |   | | | | / __|| '_ \| |/ /| || '_ \ 
 | |___| |_| || (__ | | | |   < | || | | |
 |_____|\__, | \___||_| |_|_|\_\|_||_| |_|
        |___/                             
LOGO
    echo -e "${NC}=================================================="
    echo -e "  • Web Panel    : $WEB_DISPLAY"
    echo -e "  • Dự án chạy   : ${GREEN}${USER_APPS} apps${NC} (qua PM2)"
    echo -e "  • Uptime       : $SERVER_UPTIME"
    echo -e "  • Tổng Data    : ↓ $RX_FMT  |  ↑ $TX_FMT"
    echo -e "${NC}--------------------------------------------------"
    echo -e "  • RAM trống    : ${RAM_FREE} MB"
    echo -e "  • ROM trống    : ${DISK_FREE}"
    echo -e "  • Thư mục gốc  : /sdcard/Download"
    echo -e "${NC}--------------------------------------------------"
    echo -e "  • Link Web     : ${CYAN}${TUNNEL_URL:-Đang kết nối...}${NC}"
    echo -e "${NC}=================================================="
    echo -e "${YELLOW}[!] Cập nhật mỗi 10 phút chẵn (:00, :10, :20, :30, :40, :50).${NC}"
    echo -e "${YELLOW}[!] Bấm Ctrl+C để đóng cổng Web Panel.${NC}"

    CURR_MIN=$(date +%-M)
    CURR_SEC=$(date +%-S)
    REM=$(( CURR_MIN % 10 ))
    [ "$REM" -eq 0 ] && WAIT_MIN=10 || WAIT_MIN=$(( 10 - REM ))
    SLEEP_SEC=$(( (WAIT_MIN * 60) - CURR_SEC ))
    [ "$SLEEP_SEC" -le 0 ] && SLEEP_SEC=600

    sleep "$SLEEP_SEC"
done
