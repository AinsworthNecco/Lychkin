#!/bin/bash

export PREFIX="/data/data/com.termux/files/usr"
export PATH="$PREFIX/bin:$PATH"

BOT_DIR="$HOME/minebot"
ENV_FILE="$HOME/.minebot_env"

# Giữ CPU thức không bị Android sleep sâu
termux-wake-lock 2>/dev/null
START_TIME=$(date +%s)

cleanup() {
    echo -e "\n\033[0;31m[!] Đang tắt Minebot và giải phóng tài nguyên...\033[0m"
    pm2 delete minebot 2>/dev/null
    pm2 kill 2>/dev/null
    termux-wake-unlock 2>/dev/null
    echo -e "\033[0;32m[✓] Đã tắt hoàn toàn.\033[0m"
    exit 0
}
trap cleanup SIGINT SIGTERM SIGHUP EXIT

# 1. Tự động cài gói còn thiếu (chỉ chạy ở lần đầu tiên)
NEED_INSTALL=0
for pkg in node git cloudflared; do
    command -v "$pkg" >/dev/null 2>&1 || NEED_INSTALL=1
done

if [ "$NEED_INSTALL" -eq 1 ]; then
    echo "[*] Đang cài đặt Node.js, Git và Cloudflared..."
    pkg update -y && pkg install nodejs-lts git cloudflared -y
fi
command -v pm2 >/dev/null 2>&1 || npm install -g pm2 >/dev/null 2>&1

# 2. Lưu GitHub Token cục bộ trên máy (tránh lộ token trên repo Lychkin)
if [ ! -f "$ENV_FILE" ]; then
    echo -n "Nhập GitHub Token (ghp_...) để tải repo private minebot: "
    read -r INPUT_TOKEN < /dev/tty
    echo "GH_TOKEN=\"$INPUT_TOKEN\"" > "$ENV_FILE"
    chmod 600 "$ENV_FILE"
fi
source "$ENV_FILE"

REPO_URL="https://${GH_TOKEN}@github.com/AinsworthNecco/minebot.git"

# 3. Clone lần đầu hoặc tự động Pull code mới nhất
if [ ! -d "$BOT_DIR/.git" ]; then
    echo "[*] Đang tải mã nguồn minebot về ~/minebot..."
    git clone "$REPO_URL" "$BOT_DIR" || { echo "[!] Sai Token hoặc không thể clone!"; rm -f "$ENV_FILE"; exit 1; }
    cd "$BOT_DIR" || exit 1
    npm install --omit=dev
else
    cd "$BOT_DIR" || exit 1
    echo "[*] Đang đồng bộ code mới từ GitHub..."
    git remote set-url origin "$REPO_URL"
    BEFORE_HASH=$(git rev-parse HEAD)
    git pull origin main >/dev/null 2>&1
    AFTER_HASH=$(git rev-parse HEAD)
    if [ "$BEFORE_HASH" != "$AFTER_HASH" ]; then
        echo "[*] Phát hiện bản cập nhật mới, đang kiểm tra thư viện..."
        npm install --omit=dev >/dev/null 2>&1
    fi
fi

# 4. Tạo config.json từ file mẫu nếu chưa có
if [ ! -f "$BOT_DIR/config.json" ] && [ -f "$BOT_DIR/config.example.json" ]; then
    cp "$BOT_DIR/config.example.json" "$BOT_DIR/config.json"
    echo -e "\033[1;33m[!] Đã tạo config.json từ file mẫu. Hãy mở ~/minebot/config.json để điền Webhook URL nếu chưa có!\033[0m"
    sleep 3
fi

# 5. Khởi chạy Minebot (tự mở Tunnel + bắn Discord Webhook bên trong index.js)
pm2 delete minebot 2>/dev/null
pm2 start index.js --name "minebot" --cwd "$BOT_DIR" >/dev/null 2>&1
pm2 save >/dev/null 2>&1

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

format_bytes() {
    local b=$1
    if [ "$b" -ge 1073741824 ]; then
        awk -v b="$b" 'BEGIN {printf "%.2f GB", b/1073741824}'
    elif [ "$b" -ge 1048576 ]; then
        awk -v b="$b" 'BEGIN {printf "%.2f MB", b/1048576}'
    elif [ "$b" -ge 1024 ]; then
        awk -v b="$b" 'BEGIN {printf "%.2f KB", b/1024}'
    else
        echo "${b} B"
    fi
}

# Vòng lặp hiển thị Termux: Ngủ đúng các mốc 10 phút chẵn
while true; do
    BOT_STATUS=$(pm2 describe minebot 2>/dev/null | grep -o "online" | head -n 1)
    [ "$BOT_STATUS" = "online" ] && BOT_DISPLAY="${GREEN}ONLINE${NC}" || BOT_DISPLAY="${RED}OFFLINE${NC}"

    RAM_FREE=$(free -m | awk '/Mem:/ {print $7}')
    [ -z "$RAM_FREE" ] && RAM_FREE=$(free -m | awk '/Mem:/ {print $4}')
    DISK_FREE=$(df -h /data 2>/dev/null | awk 'NR==2 {print $4}')

    read -r TOTAL_RX TOTAL_TX <<< "$(awk 'NR>2 && $1 !~ /lo/ {rx+=$2; tx+=$10} END {print rx, tx}' /proc/net/dev 2>/dev/null)"
    RX_FMT=$(format_bytes "${TOTAL_RX:-0}")
    TX_FMT=$(format_bytes "${TOTAL_TX:-0}")

    CURRENT_TIME=$(date +%s)
    DIFF_SEC=$(( CURRENT_TIME - START_TIME ))
    UP_DAYS=$(( DIFF_SEC / 86400 ))
    UP_HOURS=$(( (DIFF_SEC % 86400) / 3600 ))
    UP_MINS=$(( (DIFF_SEC % 3600) / 60 ))
    UP_SECS=$(( DIFF_SEC % 60 ))

    SERVER_UPTIME=""
    [ $UP_DAYS -gt 0 ] && SERVER_UPTIME="${UP_DAYS}d "
    [ $UP_HOURS -gt 0 ] && SERVER_UPTIME="${SERVER_UPTIME}${UP_HOURS}h "
    SERVER_UPTIME="${SERVER_UPTIME}${UP_MINS}m ${UP_SECS}s"

    clear
    echo -e "${CYAN}"
    cat << "LOGO"
  _                  _     _     _       
 | |    _   _   ___ | |__ | | __(_) _ __  
 | |   | | | | / __|| '_ \| |/ /| || '_ \ 
 | |___| |_| || (__ | | | |   < | || | | |
 |_____|\__, | \___||_| |_|_|\_\|_||_| |_|
        |___/                             
LOGO
    echo -e "${NC}=================================================="
    echo -e "  • Minebot      : $BOT_DISPLAY"
    echo -e "  • Tunnel       : ${GREEN}AUTO (Gửi qua Discord Webhook)${NC}"
    echo -e "  • Uptime       : $SERVER_UPTIME"
    echo -e "  • Tổng Data    : ↓ $RX_FMT  |  ↑ $TX_FMT"
    echo -e "${NC}--------------------------------------------------"
    echo -e "  • RAM trống    : ${RAM_FREE} MB"
    echo -e "  • ROM trống    : ${DISK_FREE}"
    echo -e "${NC}=================================================="
    echo -e "${YELLOW}[!] Cập nhật mỗi 10 phút chẵn (:00, :10, :20, :30, :40, :50).${NC}"
    echo -e "${YELLOW}[!] Bấm Ctrl+C để tắt toàn bộ hoặc gõ 'pm2 logs minebot' ở tab mới để xem log.${NC}"

    CURR_MIN=$(date +%-M)
    CURR_SEC=$(date +%-S)
    REM=$(( CURR_MIN % 10 ))
    [ "$REM" -eq 0 ] && WAIT_MIN=10 || WAIT_MIN=$(( 10 - REM ))
    SLEEP_SEC=$(( (WAIT_MIN * 60) - CURR_SEC ))
    [ "$SLEEP_SEC" -le 0 ] && SLEEP_SEC=600

    sleep "$SLEEP_SEC"
done
