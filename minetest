#!/bin/bash

# Cấu hình Webhook & Ảnh Embed
DISCORD_WEBHOOK="https://discord.com/api/webhooks/1522976376246763673/4OiFCAvV0Z7Bd22nIV6ZYFWXIrsxwtufoZUCpIH5J_dOuMHztuIWbcJSDqgT9Q2dDgnq"
IMAGE_URL="https://i.pinimg.com/736x/14/cd/b8/14cdb8ffeb8017a8a431f12f6c65f2a0.jpg"
WEB_PASSWORD="lychkin2026"

export PREFIX="/data/data/com.termux/files/usr"
export PATH="$PREFIX/bin:$PATH"

BOT_DIR="/sdcard/Download/minebot"
ENV_FILE="$HOME/.minebot_env"

termux-wake-lock 2>/dev/null
START_TIME=$(date +%s)

cleanup() {
    echo -e "\n\033[0;31m[!] Đang tắt và giải phóng toàn bộ server...\033[0m"
    pm2 delete web-panel tunnel minebot 2>/dev/null
    pm2 kill 2>/dev/null
    termux-wake-unlock 2>/dev/null
    echo -e "\033[0;32m[✓] Server đã offline hoàn toàn.\033[0m"
    exit 0
}
trap cleanup SIGINT SIGTERM SIGHUP EXIT

# 1. Cấp quyền truy cập /sdcard nếu chưa có
if [ ! -d "/sdcard/Download" ]; then
    echo "[*] Đang yêu cầu quyền truy cập bộ nhớ điện thoại..."
    termux-setup-storage
    sleep 3
fi

# 2. Cài đặt gói hệ thống (chỉ chạy ở lần đầu tiên)
if ! command -v code-server >/dev/null 2>&1 || ! command -v node >/dev/null 2>&1 || ! command -v cloudflared >/dev/null 2>&1; then
    echo "[*] Đang cài đặt Node.js, Git, Cloudflared, code-server..."
    pkg update -y
    pkg install tur-repo -y
    pkg install nodejs-lts git cloudflared code-server -y
fi
command -v pm2 >/dev/null 2>&1 || npm install -g pm2 >/dev/null 2>&1

# 3. Lưu GitHub Token cục bộ trên Termux
if [ ! -f "$ENV_FILE" ]; then
    echo -n "Nhập GitHub Token (ghp_...) để tải repo minebot: "
    read -r INPUT_TOKEN < /dev/tty
    echo "GH_TOKEN=\"$INPUT_TOKEN\"" > "$ENV_FILE"
    chmod 600 "$ENV_FILE"
fi
source "$ENV_FILE"
REPO_URL="https://${GH_TOKEN}@github.com/AinsworthNecco/minebot.git"

# Khắc phục lỗi Git báo "dubious ownership" khi thao tác trên /sdcard
git config --global --add safe.directory "$BOT_DIR" 2>/dev/null

# 4. Clone lần đầu hoặc tự động Pull code mới vào /sdcard/Download/minebot
if [ ! -d "$BOT_DIR/.git" ]; then
    echo "[*] Đang tải mã nguồn về /sdcard/Download/minebot..."
    git clone "$REPO_URL" "$BOT_DIR" || { echo "[!] Sai Token hoặc lỗi mạng!"; rm -f "$ENV_FILE"; exit 1; }
    cd "$BOT_DIR" || exit 1
    npm install --omit=dev --no-bin-links
else
    cd "$BOT_DIR" || exit 1
    git remote set-url origin "$REPO_URL"
    BEFORE_HASH=$(git rev-parse HEAD)
    git pull origin main >/dev/null 2>&1
    AFTER_HASH=$(git rev-parse HEAD)
    if [ "$BEFORE_HASH" != "$AFTER_HASH" ]; then
        echo "[*] Có bản cập nhật mới, đang cài lại thư viện..."
        npm install --omit=dev --no-bin-links >/dev/null 2>&1
    fi
fi

# Tạo sẵn config.json từ file mẫu nếu chưa có
if [ ! -f "$BOT_DIR/config.json" ] && [ -f "$BOT_DIR/config.example.json" ]; then
    cp "$BOT_DIR/config.example.json" "$BOT_DIR/config.json"
fi

# 5. Cấu hình code-server trỏ thẳng vào /sdcard/Download/minebot
mkdir -p ~/.config/code-server
cat << EOF > ~/.config/code-server/config.yaml
bind-addr: 127.0.0.1:8080
auth: password
password: $WEB_PASSWORD
cert: false
EOF

pm2 delete web-panel tunnel 2>/dev/null
pm2 start "code-server $BOT_DIR" --name "web-panel" >/dev/null 2>&1
sleep 3

CLOUDFLARE_LOG="$HOME/cloudflare.log"
rm -f "$CLOUDFLARE_LOG"
pm2 start "cloudflared tunnel --url http://127.0.0.1:8080" --name "tunnel" --output "$CLOUDFLARE_LOG" --error "$CLOUDFLARE_LOG" >/dev/null 2>&1
pm2 save >/dev/null 2>&1

# Bắt link tunnel
echo "Đang khởi động Server và lấy link kết nối..."
TUNNEL_URL=""
for i in {1..30}; do
    sleep 1
    if [ -f "$CLOUDFLARE_LOG" ]; then
        TUNNEL_URL=$(grep -o 'https://[-a-zA-Z0-9@:%._\+~#=]*\.trycloudflare\.com' "$CLOUDFLARE_LOG" | tail -n 1)
        [ -n "$TUNNEL_URL" ] && break
    fi
done

# Gửi Embed về Discord
if [ -n "$TUNNEL_URL" ]; then
    curl -H "Content-Type: application/json" \
         -X POST \
         -d "{
           \"embeds\": [{
             \"title\": \"🚀 Hệ thống Host Minebot đã sẵn sàng!\",
             \"description\": \"📂 **Workspace:** \`/sdcard/Download/minebot\`\n🔗 **Web Panel:** $TUNNEL_URL\n🔑 **Mật khẩu:** \`$WEB_PASSWORD\`\",
             \"color\": 16033721,
             \"image\": { \"url\": \"$IMAGE_URL\" }
           }]
         }" \
         "$DISCORD_WEBHOOK" > /dev/null 2>&1
fi

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

format_bytes() {
    local b=$1
    if [ "$b" -ge 1073741824 ]; then
        awk -v b="$b" 'BEGIN {printf "%.2f GB", b/1073741824}'
    elif [ "$b" -ge 1048576 ]; then
        awk -v b="$b" 'BEGIN {printf "%.2f MB", b/1048576}'
    elif [ "$b" -ge 1024 ]; then
        awk -v b="$b" 'BEGIN {printf "%.2f KB", b/1024}'
    else
        echo "${b} B"
    fi
}

while true; do
    TUNNEL_STATUS=$(pm2 describe tunnel 2>/dev/null | grep -o "online" | head -n 1)
    if [ "$TUNNEL_STATUS" != "online" ]; then
        echo -e "\n${RED}[!] Cloudflare Tunnel đã ngắt kết nối.${NC}"
        cleanup
    fi

    RAM_FREE=$(free -m | awk '/Mem:/ {print $7}')
    [ -z "$RAM_FREE" ] && RAM_FREE=$(free -m | awk '/Mem:/ {print $4}')
    DISK_FREE=$(df -h /data 2>/dev/null | awk 'NR==2 {print $4}')

    read -r TOTAL_RX TOTAL_TX <<< "$(awk 'NR>2 && $1 !~ /lo/ {rx+=$2; tx+=$10} END {print rx, tx}' /proc/net/dev 2>/dev/null)"
    RX_FMT=$(format_bytes "${TOTAL_RX:-0}")
    TX_FMT=$(format_bytes "${TOTAL_TX:-0}")

    BOT_STATUS=$(pm2 describe minebot 2>/dev/null | grep -o "online" | head -n 1)
    [ "$BOT_STATUS" = "online" ] && BOT_DISPLAY="${GREEN}ONLINE${NC}" || BOT_DISPLAY="${YELLOW}CHỜ BẬT TRÊN WEB${NC}"

    CURRENT_TIME=$(date +%s)
    DIFF_SEC=$(( CURRENT_TIME - START_TIME ))
    UP_DAYS=$(( DIFF_SEC / 86400 ))
    UP_HOURS=$(( (DIFF_SEC % 86400) / 3600 ))
    UP_MINS=$(( (DIFF_SEC % 3600) / 60 ))
    UP_SECS=$(( DIFF_SEC % 60 ))

    SERVER_UPTIME=""
    [ $UP_DAYS -gt 0 ] && SERVER_UPTIME="${UP_DAYS}d "
    [ $UP_HOURS -gt 0 ] && SERVER_UPTIME="${SERVER_UPTIME}${UP_HOURS}h "
    SERVER_UPTIME="${SERVER_UPTIME}${UP_MINS}m ${UP_SECS}s"

    clear
    echo -e "${CYAN}"
    cat << "LOGO"
  _                  _     _     _       
 | |    _   _   ___ | |__ | | __(_) _ __  
 | |   | | | | / __|| '_ \| |/ /| || '_ \ 
 | |___| |_| || (__ | | | |   < | || | | |
 |_____|\__, | \___||_| |_|_|\_\|_||_| |_|
        |___/                             
LOGO
    echo -e "${NC}=================================================="
    echo -e "  • Web Panel    : ${GREEN}RUNNING (ONLINE)${NC}"
    echo -e "  • Minebot      : $BOT_DISPLAY"
    echo -e "  • Uptime       : $SERVER_UPTIME"
    echo -e "  • Tổng Data    : ↓ $RX_FMT  |  ↑ $TX_FMT"
    echo -e "${NC}--------------------------------------------------"
    echo -e "  • RAM trống    : ${RAM_FREE} MB"
    echo -e "  • ROM trống    : ${DISK_FREE}"
    echo -e "${NC}--------------------------------------------------"
    echo -e "  • Link Web     : ${CYAN}${TUNNEL_URL:-Đang kết nối...}${NC}"
    echo -e "${NC}=================================================="
    echo -e "${YELLOW}[!] Cập nhật mỗi 10 phút chẵn (:00, :10, :20, :30, :40, :50).${NC}"
    echo -e "${YELLOW}[!] Bấm Ctrl+C hoặc đóng Termux để tắt toàn bộ.${NC}"

    CURR_MIN=$(date +%-M)
    CURR_SEC=$(date +%-S)
    REM=$(( CURR_MIN % 10 ))
    [ "$REM" -eq 0 ] && WAIT_MIN=10 || WAIT_MIN=$(( 10 - REM ))
    SLEEP_SEC=$(( (WAIT_MIN * 60) - CURR_SEC ))
    [ "$SLEEP_SEC" -le 0 ] && SLEEP_SEC=600

    sleep "$SLEEP_SEC"
done
