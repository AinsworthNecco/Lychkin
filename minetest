#!/bin/bash

# Đặt link Webhook của bạn ở đây (Ví dụ Discord Webhook)
DISCORD_WEBHOOK="https://discord.com/api/webhooks/1522976376246763673/4OiFCAvV0Z7Bd22nIV6ZYFWXIrsxwtufoZUCpIH5J_dOuMHztuIWbcJSDqgT9Q2dDgnq"

# 1. Giữ máy luôn thức
termux-wake-lock 2>/dev/null

# 2. Cấu hình code-server không cần mật khẩu
mkdir -p ~/.config/code-server
cat << 'EOF' > ~/.config/code-server/config.yaml
bind-addr: 0.0.0.0:8080
auth: none
cert: false
EOF

# 3. Dừng các phiên chạy cũ để tránh trùng lặp
pm2 delete web-panel tunnel 2>/dev/null

# 4. Khởi chạy code-server
pm2 start "code-server" --name "web-panel"

# 5. Khởi chạy Cloudflare Tunnel và ghi log vào file tạm
CLOUDFLARE_LOG="$HOME/cloudflare.log"
rm -f "$CLOUDFLARE_LOG"

pm2 start "cloudflared tunnel --url http://localhost:8080" --name "tunnel" --output "$CLOUDFLARE_LOG" --error "$CLOUDFLARE_LOG"
pm2 save

# 6. Quét log tìm link trycloudflare.com
echo "Đang đợi Cloudflare khởi tạo link..."
TUNNEL_URL=""

for i in {1..30}; do
  sleep 1
  if [ -f "$CLOUDFLARE_LOG" ]; then
    TUNNEL_URL=$(grep -o 'https://[-a-zA-Z0-9@:%._\+~#=]*\.trycloudflare\.com' "$CLOUDFLARE_LOG" | tail -n 1)
    if [ -n "$TUNNEL_URL" ]; then
      break
    fi
  fi
done

# 7. Thông báo kết quả và bắn Webhook
if [ -n "$TUNNEL_URL" ]; then
  echo "Link server: $TUNNEL_URL"
  if [ -n "$DISCORD_WEBHOOK" ] && [ "$DISCORD_WEBHOOK" != "https://discord.com/api/webhooks/YOUR_WEBHOOK_URL_HERE" ]; then
    curl -H "Content-Type: application/json" \
         -X POST \
         -d "{\"content\": \"🚀 **Server Termux đã khởi động thành công!**\n🔗 **Link Web Panel:** $TUNNEL_URL\"}" \
         "$DISCORD_WEBHOOK" > /dev/null 2>&1
    echo "Đã gửi link vào Discord Webhook thành công."
  fi
else
  echo "Không tìm thấy link Tunnel trong log. Hãy kiểm tra lại kết nối mạng."
fi
