#!/bin/bash

DISCORD_WEBHOOK="https://discord.com/api/webhooks/1522976376246763673/4OiFCAvV0Z7Bd22nIV6ZYFWXIrsxwtufoZUCpIH5J_dOuMHztuIWbcJSDqgT9Q2dDgnq"
IMAGE_URL="https://i.pinimg.com/736x/14/cd/b8/14cdb8ffeb8017a8a431f12f6c65f2a0.jpg"

export PREFIX="/data/data/com.termux/files/usr"
export PATH="$PREFIX/bin:$PATH"

termux-wake-lock 2>/dev/null

START_TIME=$(date +%s)

cleanup() {
    echo -e "\n\033[0;31m[!] Đang tắt và giải phóng toàn bộ dịch vụ server...\033[0m"
    pm2 delete web-panel tunnel discord-bot server-manager 2>/dev/null
    pm2 kill 2>/dev/null
    termux-wake-unlock 2>/dev/null
    echo -e "\033[0;32m[✓] Server đã offline hoàn toàn. Thiết bị sẵn sàng bảo trì.\033[0m"
    exit 0
}
trap cleanup SIGINT SIGTERM SIGHUP EXIT

TARGET_DIR="/sdcard/Download/ServerWorkspace"
mkdir -p "$TARGET_DIR"

mkdir -p ~/.config/code-server
cat << 'EOF' > ~/.config/code-server/config.yaml
bind-addr: 127.0.0.1:8080
auth: none
cert: false
EOF

pm2 delete web-panel tunnel discord-bot server-manager 2>/dev/null

pm2 start "code-server --bind-addr 127.0.0.1:8080 --auth none $TARGET_DIR" --name "web-panel" >/dev/null 2>&1
sleep 4

CLOUDFLARE_LOG="$HOME/cloudflare.log"
rm -f "$CLOUDFLARE_LOG"
pm2 start "cloudflared tunnel --url http://127.0.0.1:8080" --name "tunnel" --output "$CLOUDFLARE_LOG" --error "$CLOUDFLARE_LOG" >/dev/null 2>&1

if [ -f "$TARGET_DIR/main.py" ]; then
    pm2 start "$TARGET_DIR/main.py" --name "discord-bot" --interpreter python --cwd "$TARGET_DIR" >/dev/null 2>&1
fi

if [ -f "$TARGET_DIR/manager.py" ]; then
    pm2 start "$TARGET_DIR/manager.py" --name "server-manager" --interpreter python --cwd "$TARGET_DIR" >/dev/null 2>&1
fi

pm2 save >/dev/null 2>&1

echo "Đang khởi động Server và lấy link kết nối..."
TUNNEL_URL=""
for i in {1..30}; do
  sleep 1
  if [ -f "$CLOUDFLARE_LOG" ]; then
    TUNNEL_URL=$(grep -o 'https://[-a-zA-Z0-9@:%._\+~#=]*\.trycloudflare\.com' "$CLOUDFLARE_LOG" | tail -n 1)
    if [ -n "$TUNNEL_URL" ]; then
      break
    fi
  fi
done

if [ -n "$TUNNEL_URL" ]; then
  curl -H "Content-Type: application/json" \
       -X POST \
       -d "{
         \"embeds\": [{
           \"title\": \"🚀 Hệ thống Server đã sẵn sàng!\",
           \"description\": \"📂 **Workspace:** \`/sdcard/Download/ServerWorkspace\`\n🔗 **Web Panel:** $TUNNEL_URL\n🤖 **Bot Python:** Đang chạy\n⚡ **Bot Quản trị:** Sẵn sàng điều khiển\",
           \"color\": 16033721,
           \"image\": { \"url\": \"$IMAGE_URL\" }
         }]
       }" \
       "$DISCORD_WEBHOOK" > /dev/null 2>&1
fi

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

format_bytes() {
    local b=$1
    if [ "$b" -ge 1073741824 ]; then
        awk -v b="$b" 'BEGIN {printf "%.2f GB", b/1073741824}'
    elif [ "$b" -ge 1048576 ]; then
        awk -v b="$b" 'BEGIN {printf "%.2f MB", b/1048576}'
    elif [ "$b" -ge 1024 ]; then
        awk -v b="$b" 'BEGIN {printf "%.2f KB", b/1024}'
    else
        echo "${b} B"
    fi
}

while true; do
    TUNNEL_STATUS=$(pm2 describe tunnel 2>/dev/null | grep -o "online" | head -n 1)
    if [ "$TUNNEL_STATUS" != "online" ]; then
        echo -e "\n${RED}[!] Phát hiện Cloudflare Tunnel đã ngắt kết nối hoặc tắt.${NC}"
        cleanup
    fi

    RAM_FREE=$(free -m | awk '/Mem:/ {print $7}')
    [ -z "$RAM_FREE" ] && RAM_FREE=$(free -m | awk '/Mem:/ {print $4}')

    DISK_FREE=$(df -h /data 2>/dev/null | awk 'NR==2 {print $4}')

    read -r TOTAL_RX TOTAL_TX <<< "$(awk 'NR>2 && $1 !~ /lo/ {rx+=$2; tx+=$10} END {print rx, tx}' /proc/net/dev 2>/dev/null)"
    RX_FMT=$(format_bytes "${TOTAL_RX:-0}")
    TX_FMT=$(format_bytes "${TOTAL_TX:-0}")

    MAIN_BOT_STATUS=$(pm2 describe discord-bot 2>/dev/null | grep -o "online" | head -n 1)
    [ "$MAIN_BOT_STATUS" = "online" ] && MAIN_BOT_DISPLAY="${GREEN}ONLINE${NC}" || MAIN_BOT_DISPLAY="${RED}OFFLINE${NC}"

    MGR_BOT_STATUS=$(pm2 describe server-manager 2>/dev/null | grep -o "online" | head -n 1)
    [ "$MGR_BOT_STATUS" = "online" ] && MGR_BOT_DISPLAY="${GREEN}ONLINE${NC}" || MGR_BOT_DISPLAY="${RED}OFFLINE${NC}"

    CURRENT_TIME=$(date +%s)
    DIFF_SEC=$(( CURRENT_TIME - START_TIME ))
    UP_DAYS=$(( DIFF_SEC / 86400 ))
    UP_HOURS=$(( (DIFF_SEC % 86400) / 3600 ))
    UP_MINS=$(( (DIFF_SEC % 3600) / 60 ))
    UP_SECS=$(( DIFF_SEC % 60 ))

    SERVER_UPTIME=""
    [ $UP_DAYS -gt 0 ] && SERVER_UPTIME="${UP_DAYS}d "
    [ $UP_HOURS -gt 0 ] && SERVER_UPTIME="${SERVER_UPTIME}${UP_HOURS}h "
    SERVER_UPTIME="${SERVER_UPTIME}${UP_MINS}m ${UP_SECS}s"

    clear
    echo -e "${CYAN}"
    cat << "LOGO"
  _                  _     _     _       
 | |   _   _  ___  | |__ | | __(_) _ __  
 | |  | | | |/ __| | '_ \| |/ /| || '_ \ 
 | |__| |_| | (__  | | | |   < | || | | |
 |_____\__, |\___| |_| |_|_|\_\|_||_| |_|
       |___/                             
LOGO
    echo -e "${NC}=================================================="
    echo -e "  • Web & Tunnel : ${GREEN}RUNNING (ONLINE)${NC}"
    echo -e "  • Bot Discord  : $MAIN_BOT_DISPLAY"
    echo -e "  • Bot Quản trị : $MGR_BOT_DISPLAY"
    echo -e "  • Uptime       : $SERVER_UPTIME"
    echo -e "  • Tổng Data    : ↓ $RX_FMT  |  ↑ $TX_FMT"
    echo -e "${NC}--------------------------------------------------"
    echo -e "  • RAM trống    : ${RAM_FREE} MB"
    echo -e "  • ROM trống    : ${DISK_FREE}"
    echo -e "${NC}--------------------------------------------------"
    echo -e "  • Link Web     : ${CYAN}${TUNNEL_URL:-Đang kết nối...}${NC}"
    echo -e "${NC}=================================================="
    echo -e "${YELLOW}[!] Cập nhật mỗi 10 phút chẵn (:00, :10, :20, :30, :40, :50).${NC}"
    echo -e "${YELLOW}[!] Bấm Ctrl+C hoặc đóng Termux để tắt toàn bộ.${NC}"

    CURR_MIN=$(date +%-M)
    CURR_SEC=$(date +%-S)
    REM=$(( CURR_MIN % 10 ))
    if [ "$REM" -eq 0 ]; then
        WAIT_MIN=10
    else
        WAIT_MIN=$(( 10 - REM ))
    fi
    SLEEP_SEC=$(( (WAIT_MIN * 60) - CURR_SEC ))
    [ "$SLEEP_SEC" -le 0 ] && SLEEP_SEC=600

    sleep "$SLEEP_SEC"
done
