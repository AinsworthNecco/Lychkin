#!/bin/bash

# Webhook Discord của bạn
DISCORD_WEBHOOK="https://discord.com/api/webhooks/1522976376246763673/4OiFCAvV0Z7Bd22nIV6ZYFWXIrsxwtufoZUCpIH5J_dOuMHztuIWbcJSDqgT9Q2dDgnq"

# Link ảnh hiển thị trên Discord Webhook (Ảnh banner embed)
IMAGE_URL="https://i.pinimg.com/736x/2a/da/e2/2adae27f829b69b2c3803664cf4f7b9e.jpg"

# Chu kỳ làm mới Dashboard (5 giây giúp máy mát và tiết kiệm pin)
INTERVAL=5

# 1. Nạp biến môi trường chuẩn Termux
export PREFIX="/data/data/com.termux/files/usr"
export PATH="$PREFIX/bin:$PATH"

# 2. Giữ máy thức không rơi vào ngủ sâu
termux-wake-lock 2>/dev/null

# Ghi lại mốc thời gian server bắt đầu chạy
START_TIME=$(date +%s)

# Hàm dọn dẹp khi tắt Termux hoặc bấm Ctrl+C
cleanup() {
    echo -e "\n\033[0;31m[!] Đang tắt và giải phóng toàn bộ server...\033[0m"
    pm2 delete web-panel tunnel 2>/dev/null
    pm2 kill 2>/dev/null
    termux-wake-unlock 2>/dev/null
    echo -e "\033[0;32m[✓] Server đã offline hoàn toàn.\033[0m"
    exit 0
}
trap cleanup SIGINT SIGTERM SIGHUP EXIT

# 3. Tạo thư mục làm việc trong Download
TARGET_DIR="/sdcard/Download/ServerWorkspace"
mkdir -p "$TARGET_DIR"

# 4. Cấu hình code-server không mật khẩu
mkdir -p ~/.config/code-server
cat << 'EOF' > ~/.config/code-server/config.yaml
bind-addr: 127.0.0.1:8080
auth: none
cert: false
EOF

# 5. Dọn dẹp tiến trình cũ
pm2 delete web-panel tunnel 2>/dev/null

# 6. Khởi chạy code-server
pm2 start "code-server --bind-addr 127.0.0.1:8080 --auth none $TARGET_DIR" --name "web-panel" >/dev/null 2>&1
sleep 4

# 7. Khởi chạy Cloudflare Tunnel
CLOUDFLARE_LOG="$HOME/cloudflare.log"
rm -f "$CLOUDFLARE_LOG"
pm2 start "cloudflared tunnel --url http://127.0.0.1:8080" --name "tunnel" --output "$CLOUDFLARE_LOG" --error "$CLOUDFLARE_LOG" >/dev/null 2>&1

# 8. Quét link trycloudflare.com
echo "Đang khởi động Server và lấy link kết nối..."
TUNNEL_URL=""
for i in {1..30}; do
  sleep 1
  if [ -f "$CLOUDFLARE_LOG" ]; then
    TUNNEL_URL=$(grep -o 'https://[-a-zA-Z0-9@:%._\+~#=]*\.trycloudflare\.com' "$CLOUDFLARE_LOG" | tail -n 1)
    if [ -n "$TUNNEL_URL" ]; then
      break
    fi
  fi
done

# 9. Bắn thông báo kèm ảnh vào Discord Webhook
if [ -n "$TUNNEL_URL" ]; then
  curl -H "Content-Type: application/json" \
       -X POST \
       -d "{
         \"embeds\": [{
           \"title\": \"🚀 Server Termux đã sẵn sàng!\",
           \"description\": \"📂 **Workspace:** \`/sdcard/Download/ServerWorkspace\`\n🔗 **Link điều khiển:** $TUNNEL_URL\",
           \"color\": 3066993,
           \"image\": { \"url\": \"$IMAGE_URL\" }
         }]
       }" \
       "$DISCORD_WEBHOOK" > /dev/null 2>&1
fi

# Màu sắc ANSI
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

get_bytes() {
    awk 'NR>2 {rx+=$2; tx+=$10} END {print rx, tx}' /proc/net/dev 2>/dev/null
}

read -r PREV_RX PREV_TX <<< "$(get_bytes)"

# 10. Vòng lặp Dashboard Realtime
while true; do
    sleep $INTERVAL
    read -r CURR_RX CURR_TX <<< "$(get_bytes)"
    
    # Tính tốc độ mạng (KB/s)
    SPEED_RX=$(( (CURR_RX - PREV_RX) / 1024 / INTERVAL ))
    SPEED_TX=$(( (CURR_TX - PREV_TX) / 1024 / INTERVAL ))
    PREV_RX=$CURR_RX
    PREV_TX=$CURR_TX

    # RAM
    RAM_TOTAL=$(free -m | awk '/Mem:/ {print $2}')
    RAM_USED=$(free -m | awk '/Mem:/ {print $3}')
    [ -n "$RAM_TOTAL" ] && [ "$RAM_TOTAL" -gt 0 ] && RAM_PERCENT=$(( RAM_USED * 100 / RAM_TOTAL )) || RAM_PERCENT=0

    # ROM (/data)
    DISK_TOTAL=$(df -h /data 2>/dev/null | awk 'NR==2 {print $2}')
    DISK_USED=$(df -h /data 2>/dev/null | awk 'NR==2 {print $3}')
    DISK_PERCENT=$(df -h /data 2>/dev/null | awk 'NR==2 {print $5}')

    # Pin
    BAT_INFO=$(termux-battery-status 2>/dev/null | grep -o '"percentage": [0-9]*' | cut -d' ' -f2)
    [ -z "$BAT_INFO" ] && BAT_INFO="N/A"

    # Trạng thái dịch vụ
    WEB_STATUS=$(pm2 describe web-panel 2>/dev/null | grep -o "online" | head -n 1)
    TUNNEL_STATUS=$(pm2 describe tunnel 2>/dev/null | grep -o "online" | head -n 1)

    if [ "$WEB_STATUS" = "online" ] && [ "$TUNNEL_STATUS" = "online" ]; then
        STATUS_DISPLAY="${GREEN}RUNNING (ONLINE)${NC}"
    elif [ "$WEB_STATUS" = "online" ] || [ "$TUNNEL_STATUS" = "online" ]; then
        STATUS_DISPLAY="${YELLOW}STARTING / RESTARTING...${NC}"
    else
        STATUS_DISPLAY="${RED}OFFLINE${NC}"
    fi

    # Tính Server Uptime từ lúc chạy script
    CURRENT_TIME=$(date +%s)
    DIFF_SEC=$(( CURRENT_TIME - START_TIME ))
    UP_DAYS=$(( DIFF_SEC / 86400 ))
    UP_HOURS=$(( (DIFF_SEC % 86400) / 3600 ))
    UP_MINS=$(( (DIFF_SEC % 3600) / 60 ))
    UP_SECS=$(( DIFF_SEC % 60 ))

    SERVER_UPTIME=""
    [ $UP_DAYS -gt 0 ] && SERVER_UPTIME="${UP_DAYS}d "
    [ $UP_HOURS -gt 0 ] && SERVER_UPTIME="${SERVER_UPTIME}${UP_HOURS}h "
    SERVER_UPTIME="${SERVER_UPTIME}${UP_MINS}m ${UP_SECS}s"

    clear
    # In Logo ASCII Lychkin
    echo -e "${CYAN}"
    cat << "LOGO"
  _                  _     _     _       
 | |   _   _  ___  | |__ | | __(_) _ __  
 | |  | | | |/ __| | '_ \| |/ /| || '_ \ 
 | |__| |_| | (__  | | | |   < | || | | |
 |_____\__, |\___| |_| |_|_|\_\|_||_| |_|
       |___/                             
LOGO
    echo -e "${NC}=================================================="
    echo -e "  • Trạng thái : $STATUS_DISPLAY"
    echo -e "  • Uptime     : $SERVER_UPTIME"
    echo -e "  • Tốc độ mạng: ↓ ${SPEED_RX} KB/s  |  ↑ ${SPEED_TX} KB/s"
    echo -e "${NC}--------------------------------------------------"
    echo -e "  • RAM        : ${RAM_USED} MB / ${RAM_TOTAL} MB (${RAM_PERCENT}%)"
    echo -e "  • Bộ nhớ ROM : ${DISK_USED} / ${DISK_TOTAL} (${DISK_PERCENT})"
    echo -e "  • Pin        : ${BAT_INFO}%"
    echo -e "${NC}--------------------------------------------------"
    echo -e "  • Link Web   : ${CYAN}${TUNNEL_URL:-Đang kết nối...}${NC}"
    echo -e "${NC}=================================================="
    echo -e "${YELLOW}[!] Bấm Ctrl+C hoặc đóng hẳn Termux để dừng Server.${NC}"
done
